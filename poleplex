#!/usr/bin/env bash

set -euo pipefail

declare -r VERSION="1.0.0"
declare -r GITHUB_REPO="RidelLazor/PolePlex"
declare -r GITHUB_API="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"
declare -r UPDATE_CHECK_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/poleplex/update_check"
declare -r CACHE_TTL=86400

declare -r AUR_BASE_URL="https://aur.archlinux.org"
declare -r AUR_RPC_URL="${AUR_BASE_URL}/rpc/v5"
declare -r ARCH_PACKAGES_URL="https://archlinux.org/packages/search/json/"
declare -r POLLINATIONS_URL="https://text.pollinations.ai/openai"
declare -r CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/poleplex"
declare -r CONFIG_FILE="${CONFIG_DIR}/poleplex.conf"
declare -r BUILD_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/poleplex/build"

USE_COLOR=true
VERBOSE=false
CLONE_MODE=true

[[ -t 2 ]] || USE_COLOR=false

color() { local c="$1"; shift; $USE_COLOR && printf "\033[%sm%s\033[0m" "$c" "$*" || printf "%s" "$*"; }
info()  { printf "%s %s\n"  "$(color '1;34' '::')" "$*"; }
ok()    { printf "%s %s\n"  "$(color '1;32' '=>')" "$*"; }
warn()  { printf "%s %s\n"  "$(color '1;33' '??')" "$*" >&2; }
err()   { printf "%s %s\n"  "$(color '1;31' '!!')" "$*" >&2; }
msg()   { printf "    %s\n" "$*"; }
debug() { $VERBOSE && printf "%s %s\n" "$(color '1;35' '--')" "$*" >&2 || true; }

usage() {
  cat <<EOF
Usage: poleplex <command> [options] [package]...

Commands:
  s, search  <term>     Search AUR and official packages
  i, info    <pkg>      Show detailed package info
  d, download <pkg>     Download a package from AUR (default)
  b, build   <pkg>      Download and build with makepkg
  x, install <pkg>      Download, build, and install package
  r, remove  <pkg>      Remove a downloaded package from cache
  u, update  [dir]      Update all downloaded packages
  h, help               Show this help message
  V, version            Show version

Options:
  -p, --path <dir>      Download/remove from specific directory
  -t, --tarball         Use tarball instead of git clone
  -v, --verbose         Verbose output
  -q, --quiet           Suppress color and info output

Shortened form (no dashes needed):
  poleplex s firefox          instead of  poleplex -s firefox
  poleplex i spotify           instead of  poleplex -i spotify
  poleplex d firefox-dev       instead of  poleplex firefox-dev
  poleplex b firefox-dev       build package
  poleplex x firefox-dev       build and install package
  poleplex r firefox-dev       remove from cache
  poleplex u                   update everything

Flags still work too:
  poleplex -s firefox          search
  poleplex -i spotify          info
  poleplex firefox-dev         download
  poleplex -u                  update

Examples:
  poleplex s  firefox
  poleplex i  spotify
  poleplex d  yay paru
  poleplex b  yay paru
  poleplex x  yay
  poleplex r  yay
  poleplex u
  poleplex -p ~/aur yay paru
  poleplex -t firefox-dev

Report bugs at: https://github.com/RidelLazor/PolePlex/issues
EOF
  exit 0
}

version() {
  echo "PolePlex v${VERSION}"
  exit 0
}

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    debug "Loading config: $CONFIG_FILE"
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
  fi
}

check_deps() {
  local missing=()
  command -v curl &>/dev/null || missing+=("curl")
  command -v git  &>/dev/null || missing+=("git")
  command -v tar  &>/dev/null || missing+=("tar")
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Missing dependencies: ${missing[*]}"
    err "Install them with your package manager."
    exit 1
  fi
}

check_build_deps() {
  local missing=()
  command -v makepkg &>/dev/null || missing+=("makepkg")
  command -v sudo &>/dev/null || missing+=("sudo")
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Missing build dependencies: ${missing[*]}"
    err "Install 'base-devel' group: sudo pacman -S base-devel"
    exit 1
  fi
}

check_pkgbuild_deps() {
  local pkg_dir="$1"

  if [[ ! -f "${pkg_dir}/PKGBUILD" ]]; then
    return 0
  fi

  local makedepends
  makedepends=$(grep "^makedepends=" "${pkg_dir}/PKGBUILD" 2>/dev/null | head -1 | sed "s/^makedepends=//" | tr -d "()'\"")

  if [[ -z "$makedepends" ]]; then
    return 0
  fi

  local missing=()
  for dep in $makedepends; do
    dep="${dep%>=*}"
    dep="${dep%<=*}"
    dep="${dep%==*}"
    dep="${dep%>*}"
    dep="${dep%<*}"

    if ! pacman -Q "$dep" &>/dev/null 2>&1; then
      missing+=("$dep")
    fi
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    warn "Missing build dependencies: ${missing[*]}"
    info "Install them with: sudo pacman -S ${missing[*]}"

    printf "%s " "$(color '1;33' 'Install now?')" >&2
    read -r -t 5 -p "[y/n] " response </dev/tty 2>/dev/null || response="n"

    if [[ "$response" == "y" || "$response" == "Y" ]]; then
      if sudo pacman -S "${missing[@]}"; then
        ok "Dependencies installed"
        return 0
      else
        err "Failed to install dependencies"
        return 1
      fi
    else
      err "Build dependencies missing. Install and try again."
      return 1
    fi
  fi

  return 0
}

check_for_updates() {
  mkdir -p "$(dirname "$UPDATE_CHECK_CACHE")"

  local cache_time=0
  if [[ -f "$UPDATE_CHECK_CACHE" ]]; then
    cache_time=$(stat -f%m "$UPDATE_CHECK_CACHE" 2>/dev/null || stat -c%Y "$UPDATE_CHECK_CACHE" 2>/dev/null || echo 0)
  fi

  local current_time
  current_time=$(date +%s)
  local time_diff=$((current_time - cache_time))

  if [[ $time_diff -lt $CACHE_TTL && -f "$UPDATE_CHECK_CACHE" ]]; then
    debug "Update check cache still valid"
    return 0
  fi

  debug "Checking for updates from GitHub..."

  local latest_release
  latest_release=$(curl -fsSL "$GITHUB_API" 2>/dev/null | python3 -c "
import sys, json
try:
  data = json.load(sys.stdin)
  tag = data.get('tag_name', '').lstrip('v')
  if tag:
    print(tag)
except:
  pass
" 2>/dev/null) || latest_release=""

  if [[ -z "$latest_release" ]]; then
    debug "Could not fetch latest version from GitHub"
    touch "$UPDATE_CHECK_CACHE"
    return 0
  fi

  echo "$latest_release" > "$UPDATE_CHECK_CACHE"

  local current_version="${VERSION}"
  if [[ "$latest_release" != "$current_version" ]]; then
    local newer=0
    if printf '%s\n%s' "$current_version" "$latest_release" | sort -V | head -1 | grep -q "^${current_version}$"; then
      newer=1
    fi

    if [[ $newer -eq 1 && "$current_version" != "$latest_release" ]]; then
      echo ""
      warn "A new version of PolePlex is available: v${latest_release} (current: v${current_version})"
      info "GitHub: https://github.com/${GITHUB_REPO}/releases/tag/v${latest_release}"
      echo ""

      printf "%s " "$(color '1;33' 'Would you like to update to the latest version?')" >&2
      read -r -t 15 -p "[Y/n] " response </dev/tty 2>/dev/null || response="Y"

      if [[ "$response" != "n" && "$response" != "N" ]]; then
        update_poleplex
      fi
    fi
  fi
}

update_poleplex() {
  info "Updating PolePlex..."

  local script_path
  script_path=$(command -v poleplex) || script_path="$0"

  if [[ ! -w "$script_path" ]]; then
    warn "Cannot write to $script_path, attempting sudo..."
    if ! command -v sudo &>/dev/null; then
      err "sudo not available. Cannot update."
      return 1
    fi
    if ! sudo bash -c "curl -fsSL https://raw.githubusercontent.com/${GITHUB_REPO}/master/poleplex -o '$script_path' && chmod +x '$script_path'"; then
      err "Failed to update PolePlex"
      return 1
    fi
  else
    if ! curl -fsSL https://raw.githubusercontent.com/${GITHUB_REPO}/master/poleplex -o "$script_path"; then
      err "Failed to download update"
      return 1
    fi
    chmod +x "$script_path"
  fi

  ok "PolePlex updated successfully"
  info "Please run your command again with the new version"
  exit 0
}

ai_suggest_fix() {
  local log_file="$1"
  local summary
  summary=$(tail -n 120 "$log_file" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')
  local prompt
  prompt=$(
    cat <<EOF
You are an expert Arch Linux package maintainer. Diagnose this build error and return only one shell command that fixes it, or NO_FIX if there is no confident fix.

Build log:
${summary}
EOF
  )

  local payload
  payload=$(python3 - "$prompt" <<'PY'
import json, sys
prompt = sys.argv[1]
print(json.dumps({
  "model": "gpt-4o-mini",
  "messages": [{"role": "user", "content": prompt}],
  "temperature": 0.2
}, separators=(",", ":")))
PY
)

  local raw_response
  raw_response=$(curl -fsSL -X POST "$POLLINATIONS_URL" -H "Content-Type: application/json" --data "$payload" 2>/dev/null) || return 1

  local suggestion
  suggestion=$(printf '%s' "$raw_response" | python3 - <<'PY'
import json, sys
raw = sys.stdin.read().strip()
if not raw:
    print('NO_FIX')
    sys.exit(0)
try:
    obj = json.loads(raw)
except Exception:
    print(raw.strip())
    sys.exit(0)
if isinstance(obj, dict):
    if 'choices' in obj and isinstance(obj['choices'], list) and obj['choices']:
        first = obj['choices'][0]
        if isinstance(first, dict):
            message = first.get('message', {})
            if isinstance(message, dict):
                content = message.get('content')
                if content:
                    print(str(content).strip())
                    sys.exit(0)
            text = first.get('text')
            if text:
                print(str(text).strip())
                sys.exit(0)
    for key in ('output', 'text', 'answer', 'content'):
        if key in obj:
            print(str(obj[key]).strip())
            sys.exit(0)
print(raw.strip())
PY
)

  suggestion=$(printf '%s\n' "$suggestion" | sed '/^```/d' | sed '1s/^bash //; 1s/^sh //; s/^```//; s/```$//' | head -n 1)
  suggestion=${suggestion//$'\r'/}
  suggestion=${suggestion##[[:space:]]*}
  suggestion=${suggestion%%[[:space:]]*}

  if [[ -z "$suggestion" || "$suggestion" == "NO_FIX" || "$suggestion" == "no_fix" || "$suggestion" == "no fix" || "$suggestion" == "NOFIX" ]]; then
    return 1
  fi

  printf '%s' "$suggestion"
}

aur_api() {
  local type="$1" arg="$2"
  if [[ "$type" == "search" ]]; then
    curl -fsS "${AUR_RPC_URL}/search/${arg}" 2>/dev/null || return 1
  elif [[ "$type" == "info" ]]; then
    curl -fsS "${AUR_RPC_URL}/info/${arg}" 2>/dev/null || return 1
  fi
}

arch_api() {
  local query="$1"
  curl -fsS "${ARCH_PACKAGES_URL}?q=${query}" 2>/dev/null || return 1
}

package_exists_in_aur() {
  local pkg="$1"
  local data
  data=$(aur_api "info" "$pkg" 2>/dev/null) || return 1

  local count
  count=$(echo "$data" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(len(d.get('results', [])))
" 2>/dev/null) || count=0

  [[ "$count" -gt 0 ]]
}

search_packages() {
  local term="$*"
  info "Searching AUR and official packages for: $term"

  local aur_data
  aur_data=$(aur_api "search" "$term" 2>/dev/null) || aur_data=""

  local arch_data
  arch_data=$(arch_api "$term" 2>/dev/null) || arch_data=""

  local aur_count=0
  if [[ -n "$aur_data" ]]; then
    aur_count=$(echo "$aur_data" | python3 -c "
import sys, json
try:
  d = json.load(sys.stdin)
  print(d.get('resultcount', 0))
except:
  print(0)
" 2>/dev/null) || aur_count=0
  fi

  local arch_count=0
  if [[ -n "$arch_data" ]]; then
    arch_count=$(echo "$arch_data" | python3 -c "
import sys, json
try:
  d = json.load(sys.stdin)
  print(len(d.get('results', [])))
except:
  print(0)
" 2>/dev/null) || arch_count=0
  fi

  if [[ "$aur_count" -eq 0 && "$arch_count" -eq 0 ]]; then
    warn "No results found for '$term'"
    exit 1
  fi

  echo ""

  if [[ "$aur_count" -gt 0 ]]; then
    printf "$(color '1;33' '=== AUR Packages ===\n')"
    printf "  %-30s %-12s %s\n" "Package" "Version" "Description"
    printf "  %-30s %-12s %s\n" "-------" "-------" "-----------"

    echo "$aur_data" | python3 -c "
import sys, json
d = json.load(sys.stdin)
for pkg in d.get('results', []):
    name = pkg.get('Name', '')
    ver = pkg.get('Version', '')
    desc = pkg.get('Description', '')[:60]
    if name:
        print(f'{name:<30s} {ver:<12s} {desc}')
" 2>/dev/null
    echo ""
  fi

  if [[ "$arch_count" -gt 0 ]]; then
    printf "$(color '1;32' '=== Official Arch Packages ===\n')"
    printf "  %-25s %-12s %-10s %s\n" "Package" "Version" "Repo" "Description"
    printf "  %-25s %-12s %-10s %s\n" "-------" "-------" "----" "-----------"

    echo "$arch_data" | python3 -c "
import sys, json
d = json.load(sys.stdin)
for pkg in d.get('results', []):
    name = pkg.get('pkgname', '')
    ver = pkg.get('pkgver', '')
    repo = pkg.get('repo', '')
    desc = pkg.get('pkgdesc', '')[:50]
    if name:
        print(f'{name:<25s} {ver:<12s} {repo:<10s} {desc}')
" 2>/dev/null
    echo ""
  fi
}

package_info() {
  local pkg="$1"
  info "Fetching info for: $pkg"

  local data
  data=$(aur_api "info" "$pkg" 2>/dev/null) || data=""

  local aur_found=0
  if [[ -n "$data" ]]; then
    aur_found=$(echo "$data" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(len(d.get('results', [])))
" 2>/dev/null) || aur_found=0
  fi

  if [[ "$aur_found" -gt 0 ]]; then
    local output
    output=$(echo "$data" | python3 -c "
import sys, json
d = json.load(sys.stdin)
results = d.get('results', [])
if not results:
    print('ERROR:not-found')
    sys.exit(0)
pkg = results[0]
fields = [
    ('Repository', 'AUR'),
    ('Name',        pkg.get('Name', '')),
    ('Version',     pkg.get('Version', '')),
    ('Description', pkg.get('Description', '')),
    ('Maintainer',  pkg.get('Maintainer', '')),
    ('Votes',       str(pkg.get('NumVotes', ''))),
    ('Out-of-date', str(pkg.get('OutOfDate', '')) if pkg.get('OutOfDate') else 'No'),
    ('Popularity',  str(pkg.get('Popularity', ''))),
    ('URL',         pkg.get('URL', '')),
    ('License',     ', '.join(pkg.get('License', [])) if isinstance(pkg.get('License'), list) else str(pkg.get('License', ''))),
    ('Submitted',   str(pkg.get('FirstSubmitted', ''))),
    ('Updated',     str(pkg.get('LastModified', ''))),
]
for label, val in fields:
    print(f'{label:20s} {val}')
" 2>/dev/null) || output=""

    echo ""
    echo "$output"
    echo ""
    return 0
  fi

  local arch_data
  arch_data=$(arch_api "$pkg" 2>/dev/null) || arch_data=""

  if [[ -n "$arch_data" ]]; then
    local arch_found
    arch_found=$(echo "$arch_data" | python3 -c "
import sys, json
d = json.load(sys.stdin)
results = d.get('results', [])
for result in results:
    if result.get('pkgname') == '$pkg':
        print('found')
        break
" 2>/dev/null) || arch_found=""

    if [[ "$arch_found" == "found" ]]; then
      echo ""
      echo "$arch_data" | python3 -c "
import sys, json
d = json.load(sys.stdin)
results = d.get('results', [])
for pkg in results:
    if pkg.get('pkgname') == '$pkg':
        fields = [
            ('Repository', pkg.get('repo', '')),
            ('Name',        pkg.get('pkgname', '')),
            ('Version',     pkg.get('pkgver', '')),
            ('Description', pkg.get('pkgdesc', '')),
            ('Architecture', pkg.get('arch', '')),
            ('URL',         pkg.get('url', '')),
            ('License',     ', '.join(pkg.get('licenses', [])) if isinstance(pkg.get('licenses'), list) else str(pkg.get('licenses', ''))),
            ('Last Updated', pkg.get('last_update', '')),
            ('Packager',     pkg.get('packager', '')),
        ]
        for label, val in fields:
            print(f'{label:20s} {val}')
        break
" 2>/dev/null
      echo ""
      return 0
    fi
  fi

  err "Package '$pkg' not found in AUR or official repositories"
  exit 1
}

download_tarball() {
  local pkg="$1" dest="$2"
  local url="${AUR_BASE_URL}/cgit/aur.git/snapshot/${pkg}.tar.gz"
  local tarball="/tmp/${pkg}.tar.gz"

  debug "Downloading tarball: $url"
  if ! curl -fSL "$url" -o "$tarball" 2>/dev/null; then
    err "Failed to download '$pkg' from AUR"
    return 1
  fi

  mkdir -p "$dest"
  debug "Extracting tarball to: $dest"
  tar -xzf "$tarball" -C "$dest"

  if [[ -d "${dest}/${pkg}" ]]; then
    ok "Downloaded '$pkg' to ${dest}/${pkg}"
  else
    err "Extraction failed for '$pkg'"
    return 1
  fi

  rm -f "$tarball"
  return 0
}

download_git() {
  local pkg="$1" dest="$2"
  local url="${AUR_BASE_URL}/${pkg}.git"
  local target="${dest}/${pkg}"

  if [[ -d "$target/.git" ]]; then
    debug "Existing repo found, pulling: $target"
    (cd "$target" && git pull --ff-only 2>/dev/null) && {
      ok "Updated '$pkg' in $target"
      return 0
    }
    warn "Git pull failed for '$pkg', re-cloning..."
    rm -rf "$target"
  fi

  debug "Cloning: $url -> $target"
  if git clone --depth 1 "$url" "$target" 2>/dev/null; then
    ok "Downloaded '$pkg' to $target"
    return 0
  else
    err "Failed to clone '$pkg' from AUR"
    return 1
  fi
}

download_package() {
  local pkg="$1" dest="$2"
  pkg="${pkg%/}"

  info "Downloading '$pkg'..."

  if ! package_exists_in_aur "$pkg"; then
    err "'$pkg' not found in AUR"
    err "It may be an official Arch package. Try: pacman -S $pkg"
    return 1
  fi

  if $CLONE_MODE; then
    download_git "$pkg" "$dest" || download_tarball "$pkg" "$dest" || {
      err "All download methods failed for '$pkg'"
      return 1
    }
  else
    download_tarball "$pkg" "$dest" || {
      err "Failed to download '$pkg'"
      return 1
    }
  fi

  if [[ -f "${dest}/${pkg}/PKGBUILD" ]]; then
    debug "PKGBUILD found for '$pkg'"
  else
    warn "No PKGBUILD found in downloaded package '$pkg'"
  fi
}

build_package() {
  local pkg="$1" dest="$2"
  local pkg_dir="${dest}/${pkg}"

  if [[ ! -d "$pkg_dir" ]]; then
    err "Package directory not found: $pkg_dir"
    err "Download the package first with: poleplex d $pkg"
    return 1
  fi

  if [[ ! -f "${pkg_dir}/PKGBUILD" ]]; then
    err "PKGBUILD not found in $pkg_dir"
    return 1
  fi

  if ! check_pkgbuild_deps "$pkg_dir"; then
    return 1
  fi

  info "Building '$pkg'..."
  debug "Build directory: $pkg_dir"

  local build_log
  build_log=$(mktemp)

  if makepkg -s >"$build_log" 2>&1; then
    ok "Built '$pkg' successfully"
    rm -f "$build_log"
    return 0
  fi

  cat "$build_log"
  err "Build failed for '$pkg'"

  local suggestion
  suggestion=$(ai_suggest_fix "$build_log") || suggestion=""
  if [[ -n "$suggestion" ]]; then
    echo
    info "AI suggested fix: $suggestion"
    printf "%s " "$(color '1;33' 'Apply fix and retry?')" >&2
    read -r -t 15 -p "[y/N] " response </dev/tty 2>/dev/null || response="n"
    if [[ "$response" == "y" || "$response" == "Y" ]]; then
      if bash -lc "$suggestion"; then
        if makepkg -s >"$build_log" 2>&1; then
          ok "Built '$pkg' successfully after AI-assisted fix"
          rm -f "$build_log"
          return 0
        fi
      fi
    fi
  fi

  rm -f "$build_log"
  return 1
}

install_package() {
  local pkg="$1" dest="$2"
  local pkg_dir="${dest}/${pkg}"

  if [[ ! -d "$pkg_dir" ]]; then
    download_package "$pkg" "$dest" || return 1
  fi

  build_package "$pkg" "$dest" || return 1

  info "Installing '$pkg'..."

  (
    cd "$pkg_dir"
    local pkg_file
    pkg_file=$(ls -t ./*.pkg.tar.zst 2>/dev/null | head -1)

    if [[ -z "$pkg_file" ]]; then
      err "No built package found in $pkg_dir"
      return 1
    fi

    debug "Installing: $pkg_file"
    if sudo pacman -U "$pkg_file" 2>&1; then
      ok "Installed '$pkg' successfully"
      return 0
    else
      err "Installation failed for '$pkg'"
      return 1
    fi
  )
}

remove_package() {
  local pkg="$1" dest="$2"
  local target="${dest}/${pkg}"

  if [[ ! -d "$target" ]]; then
    err "Package '$pkg' not found in $dest"
    return 1
  fi

  info "Removing '$pkg'..."
  rm -rf "$target"
  ok "Removed '$pkg' from $dest"
}

update_all() {
  local dir="${1:-$BUILD_DIR}"

  if [[ ! -d "$dir" ]]; then
    err "Directory does not exist: $dir"
    exit 1
  fi

  local count=0
  for pkg_dir in "$dir"/*/; do
    [[ -d "$pkg_dir" ]] || continue
    if [[ -d "${pkg_dir}.git" ]] || [[ -f "${pkg_dir}PKGBUILD" ]]; then
      local pkg_name
      pkg_name=$(basename "$pkg_dir")
      info "Updating '$pkg_name'..."
      if (cd "$pkg_dir" && git pull --ff-only 2>/dev/null); then
        ok "Updated '$pkg_name'"
        ((count++))
      else
        warn "Failed to update '$pkg_name' (not a git repo or network error)"
      fi
    fi
  done

  if [[ "$count" -eq 0 ]]; then
    warn "No AUR packages found in $dir"
  else
    ok "Updated $count package(s)"
  fi
}

is_subcommand() {
  case "$1" in
    s|search|i|info|d|download|b|build|x|install|r|remove|u|update|h|help|V|version) return 0 ;;
    *) return 1 ;;
  esac
}

main() {
  local args=()
  local command=""
  local search_term=""
  local info_pkg=""
  local remove_mode=false
  local update_mode=false
  local build_mode=false
  local install_mode=false
  local update_dir=""
  local custom_path=""

  check_deps
  load_config

  # Check for updates at startup (runs in background to not block the command)
  check_for_updates &

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage ;;
      -V|--version) version ;;
      -v|--verbose) VERBOSE=true; shift ;;
      -q|--quiet) USE_COLOR=false; shift ;;
      -s|--search) search_term="$2"; shift 2 ;;
      -i|--info) info_pkg="$2"; shift 2 ;;
      -p|--path) custom_path="$2"; shift 2 ;;
      -t|--tarball) CLONE_MODE=false; shift ;;
      -u|--update) update_mode=true; shift ;;
      --) shift; args+=("$@"); break ;;
      -*)
        err "Unknown option: $1"
        err "Run 'poleplex h' for help"
        exit 1
        ;;
      *)
        if [[ -z "$command" ]] && is_subcommand "$1"; then
          command="$1"; shift
          case "$command" in
            s|search)   search_term="${1:-}"; shift 2>/dev/null || true ;;
            i|info)     info_pkg="${1:-}"; shift 2>/dev/null || true ;;
            d|download) ;;
            b|build)    build_mode=true ;;
            x|install)  install_mode=true ;;
            r|remove)   remove_mode=true ;;
            u|update)   update_mode=true; update_dir="${1:-}"; shift 2>/dev/null || true ;;
            h|help)     usage ;;
            V|version)  version ;;
          esac
        else
          args+=("$1"); shift
        fi
        ;;
    esac
  done

  if [[ -n "$search_term" ]]; then
    search_packages "$search_term"
    exit $?
  fi

  if [[ -n "$info_pkg" ]]; then
    package_info "$info_pkg"
    exit $?
  fi

  if $update_mode; then
    update_all "$update_dir"
    exit $?
  fi

  if $remove_mode; then
    local dest="${custom_path:-$BUILD_DIR}"
    if [[ ${#args[@]} -eq 0 ]]; then
      err "No package specified to remove"
      err "Usage: poleplex r <package>"
      exit 1
    fi
    local failed=()
    for pkg in "${args[@]}"; do
      remove_package "$pkg" "$dest" || failed+=("$pkg")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
      exit 1
    fi
    exit 0
  fi

  if $build_mode; then
    check_build_deps
    local dest="${custom_path:-$BUILD_DIR}"
    if [[ ${#args[@]} -eq 0 ]]; then
      err "No package specified to build"
      err "Usage: poleplex b <package>"
      exit 1
    fi
    local failed=()
    for pkg in "${args[@]}"; do
      if [[ ! -d "${dest}/${pkg}" ]]; then
        download_package "$pkg" "$dest" || failed+=("$pkg") && continue
      fi
      build_package "$pkg" "$dest" || failed+=("$pkg")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
      exit 1
    fi
    exit 0
  fi

  if $install_mode; then
    check_build_deps
    local dest="${custom_path:-$BUILD_DIR}"
    if [[ ${#args[@]} -eq 0 ]]; then
      err "No package specified to install"
      err "Usage: poleplex x <package>"
      exit 1
    fi
    mkdir -p "$dest"
    local failed=()
    for pkg in "${args[@]}"; do
      install_package "$pkg" "$dest" || failed+=("$pkg")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
      exit 1
    fi
    exit 0
  fi

  if [[ ${#args[@]} -eq 0 ]]; then
    usage
  fi

  local dest="${custom_path:-$BUILD_DIR}"
  mkdir -p "$dest"

  local failed=()
  for pkg in "${args[@]}"; do
    download_package "$pkg" "$dest" || failed+=("$pkg")
  done

  if [[ ${#failed[@]} -gt 0 ]]; then
    err "Failed to download: ${failed[*]}"
    exit 1
  fi
}

main "$@"
