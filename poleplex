#!/usr/bin/env bash
set -euo pipefail

# ═══════════════════════════════════════════════════════════
#  PolePlex — A minimalist AUR helper
# ═══════════════════════════════════════════════════════════

declare -r VERSION="1.0.0"
declare -r AUR_BASE_URL="https://aur.archlinux.org"
declare -r AUR_RPC_URL="${AUR_BASE_URL}/rpc/v5"
declare -r CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/poleplex"
declare -r CONFIG_FILE="${CONFIG_DIR}/poleplex.conf"
declare -r BUILD_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/poleplex/build"
declare -r CHROOT_DIR="/var/lib/poleplex/chroot"
declare -r REPO_DIR="/var/lib/poleplex/repo"
declare -r REPO_LOCK="/tmp/poleplex-repo.lock"

USE_COLOR=true
VERBOSE=false
CLONE_MODE=true
CHROOT_ENABLED=false
CHROOT_READY=false
PARALLEL_JOBS=0
HAS_DEVTOOLS=false
INTERACTIVE=false
TARGET_PKG=""

[[ -t 2 ]] || USE_COLOR=false
[[ -t 0 && -t 1 ]] && INTERACTIVE=true
command -v mkarchroot &>/dev/null && HAS_DEVTOOLS=true
PARALLEL_JOBS=$(nproc 2>/dev/null || echo 4)

# ── Output helpers ────────────────────────────────────────

color() { local c="$1"; shift; $USE_COLOR && printf "\033[%sm%s\033[0m" "$c" "$*" || printf "%s" "$*"; }
info()  { printf "%s %s\n"  "$(color '1;34' '::')" "$*"; }
ok()    { printf "%s %s\n"  "$(color '1;32' '=>')" "$*"; }
warn()  { printf "%s %s\n"  "$(color '1;33' '??')" "$*" >&2; }
err()   { printf "%s %s\n"  "$(color '1;31' '!!')" "$*" >&2; }
msg()   { printf "    %s\n" "$*"; }
debug() { $VERBOSE && printf "%s %s\n" "$(color '1;35' '--')" "$*" >&2 || true; }

# ── Terminal / TUI helpers ────────────────────────────────

tput_init() { tput "$@" 2>/dev/null || true; }
hide_cursor()   { tput_init civis; }
show_cursor()   { tput_init cnorm; }
clear_screen()  { tput_init clear; }
cursor_up()     { tput_init cuu1; }
cursor_pos()    { tput_init cup "$1" "$2"; }
tput_cols()     { tput_init cols; }
tput_lines()    { tput_init lines; }
bold()          { tput_init bold; }
dim()           { tput_init dim; }
sgr0()          { tput_init sgr0; }

read_key() {
  local key
  IFS= read -r -n1 key 2>/dev/null || key=""
  if [[ "$key" == $'\e' ]]; then
    local rest=""
    local byte=""
    while IFS= read -r -n1 -t 0.002 byte 2>/dev/null; do
      rest+="$byte"
    done
    key+="$rest"
  fi
  printf "%s" "$key"
}

:

# ── Progress bar (non-TUI) ────────────────────────────────

progress_bar() {
  local current="$1" total="$2" label="$3"
  local cols=$(tput_cols)
  (( cols = cols > 60 ? 50 : cols - 10 ))
  local pct=$(( current * 100 / total ))
  local filled=$(( current * cols / total ))
  local empty=$(( cols - filled ))
  printf "\r    \033[1;34m[\033[0m"
  printf "\033[1;32m%*s\033[0m" "$filled" "" | tr ' ' '='
  printf "\033[1;34m%*s\033[0m" "$empty" "" | tr ' ' '-'
  printf "\033[1;34m]\033[0m %3d%% %s" "$pct" "$label"
  (( current == total )) && echo
}

# ── Spinner (TUI) ─────────────────────────────────────────

SPINNER_FRAMES=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
SPINNER_PID=""

spinner_start() {
  local msg="$1"
  if $INTERACTIVE; then
    local i=0
    (while $INTERACTIVE; do
      printf "\r  %s %s" "${SPINNER_FRAMES[i]}" "$msg"
      (( i = (i + 1) % ${#SPINNER_FRAMES[@]} ))
      sleep 0.08
    done) &
    SPINNER_PID=$!
  fi
}

spinner_stop() {
  [[ -n "$SPINNER_PID" ]] && kill "$SPINNER_PID" 2>/dev/null || true
  SPINNER_PID=""
  $INTERACTIVE && printf "\r%*s\r" "$(tput_cols)" ""
}

# ── Config ────────────────────────────────────────────────

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    debug "Loading config: $CONFIG_FILE"
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
  fi
  [[ $PARALLEL_JOBS -lt 1 ]] && PARALLEL_JOBS=$(nproc 2>/dev/null || echo 4)
  if $HAS_DEVTOOLS && [[ "$CHROOT_ENABLED" == true ]] && [[ -d "$CHROOT_DIR/root" ]]; then
    CHROOT_READY=true
  fi
}

# ── Dependencies ──────────────────────────────────────────

check_deps() {
  local missing=()
  command -v curl &>/dev/null || missing+=("curl")
  command -v git  &>/dev/null || missing+=("git")
  command -v tar  &>/dev/null || missing+=("tar")
  command -v pacman &>/dev/null || missing+=("pacman")
  command -v makepkg &>/dev/null || missing+=("makepkg")
  if ${CHROOT_ENABLED}; then
    command -v mkarchroot &>/dev/null || missing+=("devtools")
  fi
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Missing dependencies: ${missing[*]}"
    exit 1
  fi
}

# ── AUR API ───────────────────────────────────────────────

urlencode() {
  python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))" "$1" 2>/dev/null
}

aur_api() {
  local type="$1" arg="$2"
  arg=$(urlencode "$arg")
  if [[ "$type" == "search" ]]; then
    curl -fsS "${AUR_RPC_URL}/search/${arg}" 2>/dev/null || return 1
  elif [[ "$type" == "info" ]]; then
    curl -fsS "${AUR_RPC_URL}/info/${arg}" 2>/dev/null || return 1
  fi
}

aur_json() {
  python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
${1}
" 2>/dev/null
}

# ── Package info (JSON helpers) ───────────────────────────

pkg_count() { aur_json "print(d.get('resultcount', 0))"; }
pkg_results() { aur_json "
for p in d.get('results', []):
    print(p.get('Name', ''), p.get('Version', ''), p.get('Maintainer', 'orphan'), p.get('Description', ''), sep='|')
"; }
pkg_field() {
  local field="$1"
  aur_json "
p = d.get('results', [{}])[0]
print(p.get('${field}', ''))
"
}

# ── Search ────────────────────────────────────────────────

search_packages() {
  local term="$*"
  info "Searching AUR for: $term"

  local data
  data=$(aur_api "search" "$term") || {
    err "Search failed (network error or AUR down)"
    exit 1
  }

  local count
  count=$(echo "$data" | pkg_count)

  if [[ -z "$count" || "$count" -eq 0 ]]; then
    warn "No results found for '$term'"
    exit 1
  fi

  echo ""
  printf "  %-30s %-18s %-12s %s\n" "Package" "Author" "Version" "Description"
  printf "  %-30s %-18s %-12s %s\n" "-------" "------" "-------" "-----------"

  echo "$data" | pkg_results | while IFS='|' read -r name ver author desc; do
    printf "  %-30s %-18s %-12s %s\n" "$name" "$author" "$ver" "$desc"
  done
  echo ""
}

# ── Interactive search TUI ────────────────────────────────



# ─── Package info ─────────────────────────────────────────

package_info() {
  local pkg="$1"
  info "Fetching info for: $pkg"

  local data
  data=$(aur_api "info" "$pkg") || {
    err "Failed to get info for '$pkg' (not found or network error)"
    exit 1
  }

  local count
  count=$(echo "$data" | pkg_count)
  if [[ "$count" -eq 0 ]]; then
    err "Package '$pkg' not found in AUR"
    exit 1
  fi

  echo ""
  printf "  %-20s %s\n" "Repository:" "AUR"
  printf "  %-20s %s\n" "Name:"        "$(echo "$data" | pkg_field Name)"
  printf "  %-20s %s\n" "Version:"     "$(echo "$data" | pkg_field Version)"
  printf "  %-20s %s\n" "Description:" "$(echo "$data" | pkg_field Description)"
  printf "  %-20s %s\n" "Maintainer:"  "$(echo "$data" | pkg_field Maintainer)"
  printf "  %-20s %s\n" "Votes:"       "$(echo "$data" | pkg_field NumVotes)"
  printf "  %-20s %s\n" "Popularity:"  "$(echo "$data" | pkg_field Popularity)"
  printf "  %-20s %s\n" "URL:"         "$(echo "$data" | pkg_field URL)"
  printf "  %-20s %s\n" "License:"     "$(echo "$data" | pkg_field License)"
  echo ""
}

# ═══════════════════════════════════════════════════════════
#  PKGBUILD parsing (regex only — no source execution)
# ═══════════════════════════════════════════════════════════

parse_pkgbuild_field() {
  local pkgdir="$1" field="$2"
  local pkgbuild="${pkgdir}/PKGBUILD"
  [[ -f "$pkgbuild" ]] || return 1

  # Extract the array without sourcing: match `field=(...)` across lines
  # Handles: field=('a' 'b')  and multiline: field=(\n'a'\n'b'\n)
  local raw
  raw=$(sed -n "/^${field}=/,/^)/p" "$pkgbuild" 2>/dev/null | \
        tr -d '\n' | \
        grep -o "'[^']*'" | \
        tr -d "'" || true)

  # Also try: field=(a b)  without quotes (for simple strings)
  if [[ -z "$raw" ]]; then
    raw=$(sed -n "/^${field}=/,/^)/p" "$pkgbuild" 2>/dev/null | \
          tr -d '\n' | \
          sed 's/^[^=]*=//' | \
          grep -o '([^)]*)' | \
          tr -d '()' || true)
  fi
  echo "$raw"
}

parse_pkgbuild_deps() {
  local pkgdir="$1"
  local depends makedepends
  depends=$(parse_pkgbuild_field "$pkgdir" "depends")
  makedepends=$(parse_pkgbuild_field "$pkgdir" "makedepends")
  echo "$depends $makedepends"
}

strip_dep() {
  # Remove version constraints: pkg>=1.0 -> pkg, pkg=2 -> pkg
  # Handle alternatives: foo|bar -> foo
  local dep="$1"
  dep="${dep%%[><=]*}"
  dep="${dep%%[\|]*}"
  dep="${dep//[[:space:]]/}"
  echo "$dep"
}

# ═══════════════════════════════════════════════════════════
#  Dependency resolution
# ═══════════════════════════════════════════════════════════

declare -a RESOLVED_ORDER=()
declare -A RESOLVED_SEEN=()

is_installed() { pacman -Qi "$1" &>/dev/null; }

is_repo_pkg() { pacman -Si "$1" &>/dev/null; }

is_aur_pkg() {
  local data
  data=$(aur_api "info" "$1" 2>/dev/null) || return 1
  local count
  count=$(echo "$data" | pkg_count 2>/dev/null || echo 0)
  [[ "$count" -gt 0 ]]
}

resolve_deps() {
  local pkg="$1" dest="$2"
  RESOLVED_ORDER=()
  RESOLVED_SEEN=()

  _resolve() {
    local pkg="$1"
    local stripped
    stripped=$(strip_dep "$pkg")
    [[ -z "$stripped" ]] && return

    # Already processed this exact dep
    if [[ -n "${RESOLVED_SEEN[$stripped]:-}" ]]; then
      return
    fi
    RESOLVED_SEEN[$stripped]=1

    # Skip if installed or in official repos
    if is_installed "$stripped"; then
      debug "  dep '$stripped' already installed, skipping"
      return
    fi
    if is_repo_pkg "$stripped"; then
      debug "  dep '$stripped' in official repos (handled by pacman)"
      REPO_DEPS+=("$stripped")
      return
    fi

    # Check AUR
    if ! is_aur_pkg "$stripped"; then
      debug "  dep '$stripped' not found in AUR or repos, skipping"
      return
    fi

    # Download and parse its deps
    local pkgdir="${dest}/${stripped}"
    if [[ ! -d "$pkgdir" ]]; then
      debug "  downloading AUR dep '$stripped'..."
      download_package "$stripped" "$dest" 2>/dev/null || {
        warn "  failed to download '$stripped', skipping"
        return
      }
    fi

    # Recursively resolve sub-deps
    local sub_deps
    sub_deps=$(parse_pkgbuild_deps "$pkgdir")
    for sub in $sub_deps; do
      _resolve "$sub"
    done

    # Record this pkg for building (leaf-first order)
    RESOLVED_ORDER+=("$stripped")
  }

  local pkgdir="${dest}/${pkg}"
  if [[ -d "$pkgdir" ]]; then
    local deps
    deps=$(parse_pkgbuild_deps "$pkgdir")
    for dep in $deps; do
      _resolve "$dep"
    done
  fi

  # Print resolved order
  for p in "${RESOLVED_ORDER[@]}"; do echo "$p"; done
}

# ═══════════════════════════════════════════════════════════
#  DAG depth analysis for parallel builds
# ═══════════════════════════════════════════════════════════

declare -A DEP_DEPTHS=()

compute_dep_depths() {
  local pkg="$1" dest="$2"
  DEP_DEPTHS=()

  _compute() {
    local pkg="$1" depth="$2"
    local stripped
    stripped=$(strip_dep "$pkg")
    [[ -z "$stripped" ]] && return

    # Record max depth for this dep
    local cur="${DEP_DEPTHS[$stripped]:--1}"
    if (( depth > cur )); then
      DEP_DEPTHS[$stripped]=$depth
    fi

    local pkgdir="${dest}/${stripped}"
    [[ ! -d "$pkgdir" ]] && return
    local deps
    deps=$(parse_pkgbuild_deps "$pkgdir")
    for sub in $deps; do
      _compute "$sub" $(( depth + 1 ))
    done
  }

  local pkgdir="${dest}/${pkg}"
  if [[ ! -d "$pkgdir" ]]; then
    return
  fi
  local deps
  deps=$(parse_pkgbuild_deps "$pkgdir")
  for dep in $deps; do
    _compute "$dep" 0
  done
}

group_deps_by_depth() {
  local -n deps_ref="$1"
  declare -A depth_groups
  local max_depth=0

  for dep in "${deps_ref[@]}"; do
    local d="${DEP_DEPTHS[$dep]:-0}"
    depth_groups[$d]+=" $dep"
    (( d > max_depth )) && max_depth=$d
  done

  # Print depth groups, deepest first
  for (( d = max_depth; d >= 0; d-- )); do
    local group="${depth_groups[$d]:-}"
    [[ -n "$group" ]] && echo "$d|$group"
  done
}

# ═══════════════════════════════════════════════════════════
#  Chroot management
# ═══════════════════════════════════════════════════════════

chroot_setup() {
  if ! $HAS_DEVTOOLS; then
    warn "devtools not installed — building without chroot isolation"
    warn "Install: sudo pacman -S devtools"
    CHROOT_ENABLED=false
    return 1
  fi

  if [[ -d "$CHROOT_DIR/root" ]]; then
    CHROOT_READY=true
    debug "Chroot already exists at $CHROOT_DIR"
    return 0
  fi

  info "Setting up build chroot (this may take a while)..."
  info "  Location: $CHROOT_DIR"
  info "  Downloads base-devel — ~30-60s on first run"

  sudo mkdir -p "$CHROOT_DIR"
  if sudo mkarchroot "$CHROOT_DIR/root" base-devel 2>&1; then
    CHROOT_READY=true
    ok "Chroot ready at $CHROOT_DIR"
  else
    err "Failed to create chroot"
    err "  Try manually: sudo mkarchroot $CHROOT_DIR/root base-devel"
    err "  Falling back to direct makepkg (no isolation)"
    CHROOT_ENABLED=false
    CHROOT_READY=false
    return 1
  fi
}

chroot_setup_local_repo() {
  sudo mkdir -p "$REPO_DIR"
  if [[ ! -f "$REPO_DIR/poleplex.db.tar.gz" ]]; then
    sudo repo-add "$REPO_DIR/poleplex.db.tar.gz" 2>/dev/null || true
  fi

  # Add [poleplex] repo to chroot's pacman.conf if not present
  local pacman_conf="${CHROOT_DIR}/root/etc/pacman.conf"
  if [[ -f "$pacman_conf" ]] && ! grep -q "\[poleplex\]" "$pacman_conf" 2>/dev/null; then
    echo "" | sudo tee -a "$pacman_conf" >/dev/null
    echo "[poleplex]" | sudo tee -a "$pacman_conf" >/dev/null
    echo "SigLevel = Never" | sudo tee -a "$pacman_conf" >/dev/null
    echo "Server = file://${REPO_DIR}" | sudo tee -a "$pacman_conf" >/dev/null
    ok "Added [poleplex] repo to chroot pacman.conf"
  fi
}

chroot_build_pkg() {
  local pkg="$1" pkgdir="$2"
  if ! $CHROOT_READY; then
    info "Building '$pkg' with makepkg (no chroot)..."
    (cd "$pkgdir" && makepkg -s --noconfirm) || return 1
    return 0
  fi

  info "Building '$pkg' in clean chroot..."
  local build_ok=true
  (
    cd "$pkgdir"
    sudo makechrootpkg -c -r "$CHROOT_DIR" -n --noconfirm 2>&1
  ) || build_ok=false

  if ! $build_ok; then
    warn "Chroot build failed for '$pkg', falling back to direct makepkg..."
    (cd "$pkgdir" && makepkg -s --noconfirm) || {
      err "Both chroot and direct build failed for '$pkg'"
      return 1
    }
  fi
  return 0
}

chroot_install_pkg() {
  local pkg="$1" pkgdir="$2"

  local pkgfile
  pkgfile=$(find "$pkgdir" -maxdepth 1 -name "*.pkg.tar.zst" -print -quit 2>/dev/null) || true

  if [[ -z "$pkgfile" ]]; then
    # Search both chroot output and tarball-cached locations
    pkgfile=$(find /var/lib/poleplex/chroot/"$USER"/build/ -name "${pkg}-*.pkg.tar.zst" -print -quit 2>/dev/null) || true
  fi
  if [[ -z "$pkgfile" ]] && $CHROOT_READY; then
    pkgfile=$(find "$CHROOT_DIR" -path "*/build/*" -name "${pkg}-*.pkg.tar.zst" -print -quit 2>/dev/null) || true
  fi

  if [[ -n "$pkgfile" ]]; then
    info "Installing '$pkg' from package file..."
    sudo pacman -U --noconfirm "$pkgfile" || return 1
  else
    info "Building and installing '$pkg' directly..."
    (cd "$pkgdir" && sudo makepkg -si --noconfirm) || return 1
  fi
}

chroot_add_to_repo() {
  local pkg="$1" pkgdir="$2"
  local pkgfile

  # Search chroot build output first, then local pkgdir
  pkgfile=$(find /var/lib/poleplex/chroot/ -path "*/build/*" -name "${pkg}-*.pkg.tar.zst" -print -quit 2>/dev/null) || true
  if [[ -z "$pkgfile" ]]; then
    pkgfile=$(find "$pkgdir" -maxdepth 1 -name "*.pkg.tar.zst" -print -quit 2>/dev/null) || true
  fi

  if [[ -z "$pkgfile" ]]; then
    debug "No package file found for '$pkg' to add to local repo"
    return 1
  fi

  sudo cp "$pkgfile" "$REPO_DIR/"
  (
    flock "$REPO_LOCK" -c "
      cd $REPO_DIR
      sudo repo-add poleplex.db.tar.gz \"$(basename "$pkgfile")\" 2>/dev/null
    "
  ) || true
  debug "Added '$pkg' to local repo"
  return 0
}

# ═══════════════════════════════════════════════════════════
#  Build + Install (parallel-aware)
# ═══════════════════════════════════════════════════════════

declare -a REPO_DEPS=()

build_and_install_aur_deps() {
  local dest="$1"
  local -a aur_deps=("${!2}")
  local total=${#aur_deps[@]}

  if [[ "$total" -eq 0 ]]; then
    return 0
  fi

  # Compute DAG depths and group by depth
  info "Resolving dependency graph..."
  compute_dep_depths "$TARGET_PKG" "$dest"

  local -a depth_groups=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && depth_groups+=("$line")
  done < <(group_deps_by_depth aur_deps)

  info "Building ${total} AUR dependencies in ${#depth_groups[@]} batch(es)..."

  local -a failed_deps=()

  for group in "${depth_groups[@]}"; do
    local depth="${group%%|*}"
    local pkgs="${group#*|}"
    [[ -z "$pkgs" ]] && continue

    # Count packages in this batch
    local -a batch=($pkgs)
    local batch_size=${#batch[@]}

    if (( batch_size == 1 )); then
      # Single dep — build inline
      local dep="${batch[0]}"
      local pkgdir="${dest}/${dep}"
      spinner_start "Building dep '$dep'..."
      if ! [[ -d "$pkgdir" ]]; then
        warn "Package directory missing for '$dep', skipping"
        failed_deps+=("$dep")
      elif chroot_build_pkg "$dep" "$pkgdir"; then
        chroot_add_to_repo "$dep" "$pkgdir"
        chroot_install_pkg "$dep" "$pkgdir" || true
        ok "Built '$dep'"
      else
        warn "Failed to build '$dep'"
        failed_deps+=("$dep")
      fi
      spinner_stop
    else
      # Multiple deps at same depth — build in parallel
      info "Building ${batch_size} deps in parallel (depth ${depth})..."
      local pids=()
      local -a parallel_pkgs=()

      for dep in "${batch[@]}"; do
        parallel_pkgs+=("$dep")
        (
          local pkgdir="${dest}/${dep}"
          if ! [[ -d "$pkgdir" ]]; then
            warn "Package directory missing for '$dep', skipping"
            exit 1
          fi
          if chroot_build_pkg "$dep" "$pkgdir"; then
            chroot_add_to_repo "$dep" "$pkgdir"
            chroot_install_pkg "$dep" "$pkgdir" || true
            ok "Built '$dep'"
            exit 0
          else
            warn "Failed to build '$dep'"
            exit 1
          fi
        ) &
        pids+=($!)
      done

      # Wait for all parallel builds in this batch
      local i=0
      for pid in "${pids[@]}"; do
        wait "$pid" || failed_deps+=("${parallel_pkgs[i]}")
        ((i++))
      done
    fi
  done

  if [[ ${#failed_deps[@]} -gt 0 ]]; then
    warn "The following AUR dependencies failed to build: ${failed_deps[*]}"
  fi

  # Install repo deps all at once
  if [[ ${#REPO_DEPS[@]} -gt 0 ]]; then
    info "Installing ${#REPO_DEPS[@]} official repo dependencies..."
    sudo pacman -S --asdeps --noconfirm --needed "${REPO_DEPS[@]}" || {
      warn "Some repo packages failed to install"
    }
  fi
}

install_package() {
  local pkg="$1"
  local dest="${CUSTOM_PATH:-$BUILD_DIR}"
  mkdir -p "$dest"

  # Step 1: Download target package
  info "Downloading '$pkg'..."
  download_package "$pkg" "$dest" || {
    err "Failed to download '$pkg'"
    return 1
  }

  # Step 2: Setup chroot if enabled
  if $CHROOT_ENABLED; then
    chroot_setup || true
    $CHROOT_READY && chroot_setup_local_repo
  fi

  # Step 3: Resolve dependencies
  info "Resolving dependencies for '$pkg'..."
  REPO_DEPS=()
  local pkgdir="${dest}/${pkg}"

  local -a aur_deps=()
  while IFS= read -r dep; do
    [[ -n "$dep" ]] && aur_deps+=("$dep")
  done < <(resolve_deps "$pkg" "$dest")

  # Step 4: Build and install AUR dependencies
  TARGET_PKG="$pkg"
  if [[ ${#aur_deps[@]} -gt 0 ]]; then
    info "Found ${#aur_deps[@]} AUR dependencies: ${aur_deps[*]}"
    build_and_install_aur_deps "$dest" aur_deps[@]
  fi

  # Step 5: Build the target package
  if $CHROOT_READY; then
    if chroot_build_pkg "$pkg" "$pkgdir"; then
      chroot_install_pkg "$pkg" "$pkgdir"
      ok "Installed '$pkg' from chroot build"
      sudo pacman -D --asexplicit "$pkg" 2>/dev/null || true
    else
      err "Failed to build '$pkg' in chroot"
      return 1
    fi
  else
    info "Building and installing '$pkg'..."
    (cd "$pkgdir" && sudo makepkg -si --noconfirm) || {
      err "Failed to build/install '$pkg'"
      return 1
    }
    ok "Installed '$pkg'"
  fi
}

build_package_only() {
  local pkg="$1"
  local dest="${CUSTOM_PATH:-$BUILD_DIR}"
  mkdir -p "$dest"

  info "Downloading '$pkg'..."
  download_package "$pkg" "$dest" || return 1

  if $CHROOT_ENABLED; then
    chroot_setup || true
    $CHROOT_READY && chroot_setup_local_repo
  fi

  REPO_DEPS=()
  local pkgdir="${dest}/${pkg}"

  local -a aur_deps=()
  while IFS= read -r dep; do
    [[ -n "$dep" ]] && aur_deps+=("$dep")
  done < <(resolve_deps "$pkg" "$dest")

  if [[ ${#aur_deps[@]} -gt 0 ]]; then
    build_and_install_aur_deps "$dest" aur_deps[@]
  fi

  if $CHROOT_READY; then
    chroot_build_pkg "$pkg" "$pkgdir" || return 1
  else
    (cd "$pkgdir" && makepkg -s --noconfirm) || return 1
  fi

  ok "Built '$pkg' — package file in $pkgdir"
}

# ═══════════════════════════════════════════════════════════
#  Download
# ═══════════════════════════════════════════════════════════

download_tarball() {
  local pkg="$1" dest="$2"
  local url="${AUR_BASE_URL}/cgit/aur.git/snapshot/${pkg}.tar.gz"
  local tarball="/tmp/${pkg}.tar.gz"

  debug "Downloading tarball: $url"
  if ! curl -fSL "$url" -o "$tarball" 2>/dev/null; then
    err "Failed to download '$pkg' from AUR"
    return 1
  fi

  mkdir -p "$dest"
  tar -xzf "$tarball" -C "$dest"

  if [[ -d "${dest}/${pkg}" ]]; then
    ok "Downloaded '$pkg' to ${dest}/${pkg}"
  else
    err "Extraction failed for '$pkg'"
    return 1
  fi

  rm -f "$tarball"
  return 0
}

download_git() {
  local pkg="$1" dest="$2"
  local url="${AUR_BASE_URL}/${pkg}.git"
  local target="${dest}/${pkg}"

  if [[ -d "$target/.git" ]]; then
    debug "Existing repo found, pulling: $target"
    (cd "$target" && git pull --ff-only 2>/dev/null) && {
      ok "Updated '$pkg' in $target"
      return 0
    }
    warn "Git pull failed for '$pkg', re-cloning..."
    rm -rf "$target"
  fi

  debug "Cloning: $url -> $target"
  if git clone --depth 1 "$url" "$target" 2>/dev/null; then
    ok "Downloaded '$pkg' to $target"
    return 0
  else
    err "Failed to clone '$pkg' from AUR"
    return 1
  fi
}

download_package() {
  local pkg="$1" dest="$2"
  pkg="${pkg%/}"

  spinner_start "Downloading '$pkg'..."

  if $CLONE_MODE; then
    download_git "$pkg" "$dest" || download_tarball "$pkg" "$dest" || {
      spinner_stop
      return 1
    }
  else
    download_tarball "$pkg" "$dest" || {
      spinner_stop
      return 1
    }
  fi

  spinner_stop

  if [[ -f "${dest}/${pkg}/PKGBUILD" ]]; then
    debug "PKGBUILD found for '$pkg'"
  else
    warn "No PKGBUILD found in downloaded package '$pkg'"
  fi
}

# ═══════════════════════════════════════════════════════════
#  Remove / Update
# ═══════════════════════════════════════════════════════════

remove_package() {
  local pkg="$1" dest="$2"
  local target="${dest}/${pkg}"

  if [[ ! -d "$target" ]]; then
    err "Package '$pkg' not found in $dest"
    return 1
  fi

  info "Removing '$pkg'..."
  rm -rf "$target"
  ok "Removed '$pkg' from $dest"
}

update_all() {
  local dir="${1:-$BUILD_DIR}"

  if [[ ! -d "$dir" ]]; then
    err "Directory does not exist: $dir"
    exit 1
  fi

  local count=0
  for pkg_dir in "$dir"/*/; do
    [[ -d "$pkg_dir" ]] || continue
    if [[ -d "${pkg_dir}.git" ]] || [[ -f "${pkg_dir}PKGBUILD" ]]; then
      local pkg_name
      pkg_name=$(basename "$pkg_dir")
      info "Updating '$pkg_name'..."
      if (cd "$pkg_dir" && git pull --ff-only 2>/dev/null); then
        ok "Updated '$pkg_name'"
        ((count++))
      else
        warn "Failed to update '$pkg_name' (not a git repo or network error)"
      fi
    fi
  done

  if [[ "$count" -eq 0 ]]; then
    warn "No AUR packages found in $dir"
  else
    ok "Updated $count package(s)"
  fi
}

# ═══════════════════════════════════════════════════════════
#  Self-update
# ═══════════════════════════════════════════════════════════

self_update() {
  local repo_dir="$HOME/poleplex"

  # Allow override via POLEPLEX_DIR env var or config
  if [[ -n "${POLEPLEX_DIR:-}" ]]; then
    repo_dir="$POLEPLEX_DIR"
  fi

  if [[ ! -d "$repo_dir/.git" ]]; then
    # Check if the script itself lives inside a git repo
    local script_dir
    script_dir=$(dirname "$(readlink -f "$0")" 2>/dev/null || dirname "$0")
    if [[ -d "$script_dir/../.git" ]]; then
      repo_dir=$(cd "$script_dir/.." && pwd)
    else
      info "PolePlex repo not found at $repo_dir — cloning..."
      git clone --depth 1 "https://github.com/RidelLazor/PolePlex.git" "$repo_dir" || {
        err "Failed to clone repository"
        return 1
      }
    fi
  fi

  info "Checking for updates in $repo_dir..."
  (
    cd "$repo_dir" || return 1
    local old_rev
    old_rev=$(git rev-parse HEAD)
    git pull --ff-only || {
      err "Git pull failed"
      return 1
    }
    local new_rev
    new_rev=$(git rev-parse HEAD)

    if [[ "$old_rev" == "$new_rev" ]]; then
      ok "Already up to date"
      return 0
    fi

    ok "Updated ($(git log --oneline "$old_rev..$new_rev" | wc -l) new commit(s))"

    # Reinstall
    if make install-local &>/dev/null; then
      ok "Reinstalled to ~/.local/bin/poleplex"
    else
      install -m755 poleplex "$HOME/.local/bin/poleplex" 2>/dev/null && \
        ok "Reinstalled to ~/.local/bin/poleplex"
    fi
  )
}

# ═══════════════════════════════════════════════════════════
#  CLI
# ═══════════════════════════════════════════════════════════

usage() {
  cat <<EOF
Usage: poleplex <command> [options] [package]...

Commands:
  s, search    <term>     Search AUR
  info         <pkg>      Show detailed package info
  download     <pkg>      Download a package from AUR
  i, install   <pkg>      Download + build + install (full AUR helper)
  b, build     <pkg>      Download + build only (no install)
  r, remove    <pkg>      Remove a downloaded package from cache
  u, update    [dir]      Update all downloaded packages
  self-update             Update PolePlex itself via git pull
  h, help                 Show this help message
  V, version              Show version

Options:
  -p, --path <dir>        Download/build from specific directory
  -t, --tarball           Use tarball instead of git clone
  -c, --chroot            Enable clean chroot builds (requires devtools)
  -j, --jobs <n>          Parallel build jobs (default: nproc)
  -v, --verbose           Verbose output
  -q, --quiet             Suppress color and info output

Install: curl -fsSL https://ridellazor.github.io/PolePlex/install.sh | bash

Examples:
  poleplex s firefox              interactive search
  poleplex install spotify         full install with deps
  poleplex install yay micro       install multiple packages
  poleplex b yay                   build only (no pacman -U)
  poleplex i spotify               package info
  poleplex d firefox-dev           download only
  poleplex r yay                   remove from cache
  poleplex u                       update all downloaded packages
  poleplex -c install yay          build in clean chroot (needs devtools)
  poleplex -j 4 install neovim     build with 4 parallel jobs
  poleplex -p ~/aur install x      use custom build directory
EOF
  exit 0
}

version() {
  echo "PolePlex v${VERSION}"
  exit 0
}

is_subcommand() {
  case "$1" in
    s|search|info|download|i|install|b|build|r|remove|u|update|self-update|h|help|V|version) return 0 ;;
    *) return 1 ;;
  esac
}

main() {
  # Clean up on Ctrl+C during builds
  trap 'spinner_stop; stty sane 2>/dev/null || true; show_cursor; echo ""; exit 1' INT

  local args=()
  local command=""
  local search_term=""
  local info_pkg=""
  local remove_mode=false
  local update_mode=false
  local update_dir=""
  local install_mode=false
  local build_mode=false

  CUSTOM_PATH=""

  load_config
  check_deps

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage ;;
      -V|--version) version ;;
      -v|--verbose) VERBOSE=true; shift ;;
      -q|--quiet) USE_COLOR=false; shift ;;
      -c|--chroot) CHROOT_ENABLED=true; shift ;;
      -j|--jobs) PARALLEL_JOBS="$2"; shift 2 ;;
      -s|--search) search_term="$2"; shift 2 ;;
      -i|--info) info_pkg="$2"; shift 2 ;;
      -p|--path) CUSTOM_PATH="$2"; shift 2 ;;
      -t|--tarball) CLONE_MODE=false; shift ;;
      -u|--update) update_mode=true; shift ;;
      --) shift; args+=("$@"); break ;;
      -*)
        err "Unknown option: $1"
        err "Run 'poleplex h' for help"
        exit 1
        ;;
      *)
        if [[ -z "$command" ]] && is_subcommand "$1"; then
          command="$1"; shift
          case "$command" in
            s|search)     search_term="${1:-}"; shift 2>/dev/null || true ;;
            info)         info_pkg="${1:-}"; shift 2>/dev/null || true ;;
            d|download)   ;;
            i|install)    install_mode=true ;;
            b|build)      build_mode=true ;;
            r|remove)     remove_mode=true ;;
            u|update)     update_mode=true; update_dir="${1:-}"; shift 2>/dev/null || true ;;
            self-update)  self_update; exit $? ;;
            h|help)       usage ;;
            V|version)    version ;;
          esac
        else
          args+=("$1"); shift
        fi
        ;;
    esac
  done

  # ── Search (plain text only) ──
  if [[ -n "$search_term" ]]; then
    search_packages "$search_term"
    exit $?
  fi

  # ── Info ──
  if [[ -n "$info_pkg" ]]; then
    package_info "$info_pkg"
    exit $?
  fi

  # ── Update ──
  if $update_mode; then
    update_all "$update_dir"
    exit $?
  fi

  # ── Remove ──
  if $remove_mode; then
    local dest="${CUSTOM_PATH:-$BUILD_DIR}"
    if [[ ${#args[@]} -eq 0 ]]; then
      err "No package specified to remove"
      err "Usage: poleplex r <package>"
      exit 1
    fi
    local failed=()
    for pkg in "${args[@]}"; do
      remove_package "$pkg" "$dest" || failed+=("$pkg")
    done
    [[ ${#failed[@]} -eq 0 ]] || exit 1
    exit 0
  fi

  # ── Install (full AUR helper mode) ──
  if $install_mode; then
    if [[ ${#args[@]} -eq 0 ]]; then
      err "No package specified"
      err "Usage: poleplex install <package>"
      exit 1
    else
      for pkg in "${args[@]}"; do
        install_package "$pkg"
      done
    fi
    exit $?
  fi

  # ── Build only ──
  if $build_mode; then
    if [[ ${#args[@]} -eq 0 ]]; then
      err "No package specified"
      err "Usage: poleplex b <package>"
      exit 1
    fi
    for pkg in "${args[@]}"; do
      build_package_only "$pkg"
    done
    exit $?
  fi

  # ── Default: download ──
  if [[ ${#args[@]} -eq 0 ]]; then
    usage
  fi

  local dest="${CUSTOM_PATH:-$BUILD_DIR}"
  mkdir -p "$dest"

  local failed=()
  for pkg in "${args[@]}"; do
    download_package "$pkg" "$dest" || failed+=("$pkg")
  done

  if [[ ${#failed[@]} -gt 0 ]]; then
    err "Failed to download: ${failed[*]}"
    exit 1
  fi
}

main "$@"
